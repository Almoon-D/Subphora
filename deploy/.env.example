# Copy to .env (git-ignored) and fill in. Secrets live only here, never in config/ or git.

# The name the phones open, e.g. mi-pozo.duckdns.org or subphora.example.es. Its DNS
# record must point at this computer's public address (ports 80 and 443 open to it).
SUBPHORA_DOMAIN=

# Where the nightly backups go: a folder on another disk (an external USB disk), never
# inside data/. Absolute path on this computer.
SUBPHORA_BACKUP_DIR=

# The private data folder. Leave as it is unless data/ lives elsewhere.
SUBPHORA_DATA_DIR=../data

# The user the API runs as, so data/ and the backups belong to you: `id -u` and `id -g`.
SUBPHORA_UID=1000
SUBPHORA_GID=1000

# Only with a free DuckDNS name (docker compose --profile duckdns up -d): the part before
# .duckdns.org, and the token DuckDNS shows after you sign in.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# API keys the catalogue names (key_env in config/defaults/sources.yaml):
AEMET_API_KEY=
