# Caddy (MASTER_PLAN §4.9): HTTPS for SUBPHORA_DOMAIN with a certificate it obtains and
# renews by itself, /api to the API, everything else the PWA.

{$SUBPHORA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Everything but the hashed assets is asked again on every visit, so an update
		# reaches the phones (decision 0037): /sw.js above all. The assets never change.
		@mutable not path /assets/*
		header @mutable Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
